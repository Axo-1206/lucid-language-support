{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Lucid",
	"scopeName": "source.lucid",
	"patterns": [
		{
			"include": "#doc_comments"
		},
		{
			"include": "#block_comments"
		},
		{
			"include": "#line_comments"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#chars"
		},
		{
			"include": "#numerics"
		},
		{
			"include": "#keywords_declaration"
		},
		{
			"include": "#keywords_import"
		},
		{
			"include": "#keywords_control"
		},
		{
			"include": "#keywords_async"
		},
		{
			"include": "#keywords_logical"
		},
		{
			"include": "#keywords_constants"
		},
		{
			"include": "#type_decl_keywords"
		},
		{
			"include": "#primitive_types"
		},
		{
			"include": "#intrinsics"
		},
		{
			"include": "#attributes"
		},
		{
			"include": "#operators"
		},
		{
			"include": "#punctuation"
		},
		{
			"include": "#functions"
		}
	],
	"repository": {
		"doc_comments": {
			"name": "comment.block.documentation.lucid",
			"begin": "/--",
			"end": "--/"
		},
		"block_comments": {
			"name": "comment.block.lucid",
			"begin": "/-",
			"end": "-/"
		},
		"line_comments": {
			"name": "comment.line.double-dash.lucid",
			"match": "--.*$"
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.other.raw.multiline.lucid",
					"begin": "\"\"\"",
					"end": "\"\"\""
				},
				{
					"name": "string.quoted.double.lucid",
					"begin": "\"",
					"end": "\"",
					"patterns": [
						{
							"name": "constant.character.escape.lucid",
							"match": "\\\\[ntr\\\\\"'0]"
						},
						{
							"name": "constant.character.escape.unicode.lucid",
							"match": "\\\\u[0-9a-fA-F]{4}"
						},
						{
							"name": "constant.character.escape.unicode.long.lucid",
							"match": "\\\\U[0-9a-fA-F]{8}"
						},
						{
							"name": "constant.character.escape.hex.lucid",
							"match": "\\\\x[0-9a-fA-F]{2}"
						}
					]
				}
			]
		},
		"chars": {
			"name": "string.quoted.single.lucid",
			"begin": "'",
			"end": "'",
			"patterns": [
				{
					"name": "constant.character.escape.lucid",
					"match": "\\\\[ntr\\\\\"'0]"
				}
			]
		},
		"numerics": {
			"patterns": [
				{
					"name": "constant.numeric.hex.lucid",
					"match": "\\b0[xX][0-9a-fA-F_]+\\b"
				},
				{
					"name": "constant.numeric.binary.lucid",
					"match": "\\b0[bB][01_]+\\b"
				},
				{
					"name": "constant.numeric.octal.lucid",
					"match": "\\b0[oO][0-7_]+\\b"
				},
				{
					"name": "constant.numeric.float.lucid",
					"match": "\\b\\d+\\.[\\d_]+([eE][+\\-]?\\d+)?\\b"
				},
				{
					"name": "constant.numeric.integer.lucid",
					"match": "\\b\\d+\\b"
				}
			]
		},
		"keywords_declaration": {
			"name": "keyword.declaration.lucid",
			"match": "\\b(let|const)\\b"
		},
		"keywords_import": {
			"name": "keyword.other.module.lucid",
			"match": "\\b(import|as)\\b"
		},
		"keywords_control": {
			"name": "keyword.control.lucid",
			"match": "\\b(if|else|switch|case|default|while|for|in|do|return|break|continue|spawn|join)\\b"
		},
		"keywords_async": {
			"name": "keyword.control.async.lucid",
			"match": "\\b(async|await)\\b"
		},
		"keywords_logical": {
			"name": "keyword.operator.logical.lucid",
			"match": "\\b(and|or|not)\\b"
		},
		"keywords_constants": {
			"name": "constant.language.lucid",
			"match": "\\b(true|false|nil|err)\\b"
		},
		"type_decl_keywords": {
			"name": "keyword.declaration.type.lucid",
			"match": "\\b(struct|enum|trait)\\b"
		},
		"primitive_types": {
			"name": "support.type.primitive.lucid",
			"match": "\\b(bool|byte|short|int|long|ubyte|ushort|uint|ulong|int8|int16|int32|int64|uint8|uint16|uint32|uint64|float|float32|float64|double|decimal|string|char)\\b"
		},
		"intrinsics": {
			"match": "(#)([a-zA-Z_][a-zA-Z0-9_]*)",
			"captures": {
				"1": {
					"name": "keyword.operator.intrinsic.sigil.lucid"
				},
				"2": {
					"name": "support.function.intrinsic.lucid"
				}
			}
		},
		"attributes": {
			"match": "(@)([a-zA-Z_][a-zA-Z0-9_]*)",
			"captures": {
				"1": {
					"name": "keyword.operator.attribute.sigil.lucid"
				},
				"2": {
					"name": "entity.name.attribute.lucid"
				}
			}
		},
		"functions": {
			"match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)\\s*\\(",
			"captures": {
				"1": {
					"name": "entity.name.function.lucid"
				}
			}
		},
		"operators": {
			"patterns": [
				{
					"name": "keyword.operator.compose.lucid",
					"match": "\\+>"
				},
				{
					"name": "keyword.operator.pipeline.lucid",
					"match": "\\|>"
				},
				{
					"name": "keyword.operator.arrow.lucid",
					"match": "->"
				},
				{
					"name": "keyword.operator.nullcoalesce.lucid",
					"match": "\\?\\?"
				},
				{
					"name": "keyword.operator.nullable.lucid",
					"match": "\\?(!?|\\?|\\?)"
				},
				{
					"name": "keyword.operator.range.lucid",
					"match": "\\.\\.(<)?"
				},
				{
					"name": "keyword.operator.comparison.lucid",
					"match": "(==|!=|<=|>=|<|>)"
				},
				{
					"name": "keyword.operator.assignment.lucid",
					"match": "="
				},
				{
					"name": "keyword.operator.bitwise.lucid",
					"match": "(&|\\||\\^|~|<<|>>)"
				},
				{
					"name": "keyword.operator.arithmetic.lucid",
					"match": "(\\+|-|\\*|/|%|\\*\\*)"
				},
				{
					"name": "keyword.operator.pack.lucid",
					"match": "!"
				},
				{
					"name": "keyword.operator.variadic.lucid",
					"match": "\\.\\.\\."
				},
				{
					"name": "keyword.operator.reference.lucid",
					"match": "&"
				},
				{
					"name": "variable.language.wildcard.lucid",
					"match": "\\b_\\b"
				}
			]
		},
		"punctuation": {
			"patterns": [
				{
					"name": "punctuation.accessor.module.lucid",
					"match": ":"
				},
				{
					"name": "punctuation.accessor.dot.lucid",
					"match": "\\."
				},
				{
					"name": "punctuation.separator.comma.lucid",
					"match": ","
				},
				{
					"name": "punctuation.separator.semicolon.lucid",
					"match": ";"
				},
				{
					"name": "punctuation.definition.block.lucid",
					"match": "[{}]"
				},
				{
					"name": "punctuation.definition.group.lucid",
					"match": "[()]"
				},
				{
					"name": "punctuation.definition.array.lucid",
					"match": "[\\[\\]]"
				}
			]
		}
	}
}