{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Lucid",
	"scopeName": "source.lucid",
	"patterns": [
		{
			"include": "#block_comments"
		},
		{
			"include": "#line_comments"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#chars"
		},
		{
			"include": "#numerics"
		},
		{
			"include": "#keywords"
		},
		{
			"include": "#primitive_types"
		},
		{
			"include": "#attributes"
		},
		{
			"include": "#module_qualifier"
		},
		{
			"include": "#field_access"
		},
		{
			"include": "#punctuation"
		}
	],
	"repository": {
		"block_comments": {
			"name": "comment.block.lucid",
			"begin": "/-",
			"end": "-/",
			"patterns": [
				{
					"include": "#block_comments"
				}
			]
		},
		"line_comments": {
			"name": "comment.line.double-dash.lucid",
			"match": "--.*$"
		},
		"strings": {
			"name": "string.quoted.double.lucid",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.lucid",
					"match": "\\\\[ntr\\\\\"'0]"
				}
			]
		},
		"chars": {
			"name": "string.quoted.single.lucid",
			"begin": "'",
			"end": "'",
			"patterns": [
				{
					"name": "constant.character.escape.lucid",
					"match": "\\\\[ntr\\\\\"'0]"
				}
			]
		},
		"numerics": {
			"patterns": [
				{
					"name": "constant.numeric.hex.lucid",
					"match": "[+-]?\\b0[xX][0-9a-fA-F]+\\b"
				},
				{
					"name": "constant.numeric.binary.lucid",
					"match": "[+-]?\\b0[bB][01]+\\b"
				},
				{
					"name": "constant.numeric.octal.lucid",
					"match": "[+-]?\\b0[oO][0-7]+\\b"
				},
				{
					"name": "constant.numeric.float.lucid",
					"match": "[+-]?\\b\\d+\\.\\d+([eE][+-]?\\d+)?\\b"
				},
				{
					"name": "constant.numeric.integer.lucid",
					"match": "[+-]?\\b\\d+\\b"
				}
			]
		},
		"keywords": {
			"patterns": [
				{
					"name": "keyword.control.lucid",
					"match": "\\b(import|from|enum|resource|node|on)\\b"
				},
				{
					"name": "constant.language.lucid",
					"match": "\\b(true|false|nil)\\b"
				}
			]
		},
		"primitive_types": {
			"name": "support.type.primitive.lucid",
			"match": "\\b(bool|char|string|int8|int16|int32|int64|uint8|uint16|uint32|uint64|float32|float64)\\b"
		},
		"attributes": {
			"match": "(@)([a-zA-Z_][a-zA-Z0-9_]*)",
			"captures": {
				"1": {
					"name": "keyword.operator.attribute.sigil.lucid"
				},
				"2": {
					"name": "entity.name.attribute.lucid"
				}
			}
		},
		"module_qualifier": {
			"match": "([a-zA-Z_][a-zA-Z0-9_]*)(::)",
			"captures": {
				"1": {
					"name": "entity.name.namespace.lucid"
				},
				"2": {
					"name": "punctuation.accessor.module.lucid"
				}
			}
		},
		"field_access": {
			"match": "\\.([a-zA-Z_][a-zA-Z0-9_]*)",
			"captures": {
				"1": {
					"name": "variable.other.field.lucid"
				}
			}
		},
		"punctuation": {
			"patterns": [
				{
					"name": "punctuation.accessor.module.lucid",
					"match": "::"
				},
				{
					"name": "punctuation.accessor.dot.lucid",
					"match": "\\."
				},
				{
					"name": "punctuation.separator.comma.lucid",
					"match": ","
				},
				{
					"name": "punctuation.separator.colon.lucid",
					"match": ":"
				},
				{
					"name": "punctuation.separator.assignment.lucid",
					"match": "="
				},
				{
					"name": "punctuation.definition.block.lucid",
					"match": "[{}]"
				},
				{
					"name": "punctuation.definition.group.lucid",
					"match": "[()]"
				},
				{
					"name": "punctuation.definition.array.lucid",
					"match": "[\\[\\]]"
				}
			]
		}
	}
}