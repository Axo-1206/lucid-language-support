{
	"name": "lucid-language-support",
	"displayName": "Lucid Language Support",
	"icon": "icon.png",
	"description": "Syntax highlighting and support for the Lucid graph format",
	"publisher": "Axo",
	"version": "0.4.0",
	"repository": {
		"type": "git",
		"url": "https://github.com/Axo-1206/lucid-language-support.git"
	},
	"license": "MIT",
	"engines": {
		"vscode": "^1.80.0"
	},
	"categories": [
		"Programming Languages"
	],
	"contributes": {
		"languages": [
			{
				"id": "lucid",
				"aliases": [
					"Lucid",
					"lucid"
				],
				"extensions": [
					".lucid"
				],
				"icon": {
					"light": "./icons/logo.svg",
					"dark": "./icons/logo.svg"
				},
				"configuration": "./language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "lucid",
				"scopeName": "source.lucid",
				"path": "./syntaxes/lucid.tmLanguage.json"
			}
		],
		"snippets": [
			{
				"language": "lucid",
				"path": "./snippets/lucid.json"
			}
		]
	}
}