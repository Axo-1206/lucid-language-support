{
	"Import": {
		"prefix": "import",
		"body": [
			"import ${1:module.path}"
		],
		"description": "Import a module"
	},
	"Export attribute": {
		"prefix": "@export",
		"body": [
			"@export"
		],
		"description": "Mark a declaration as visible to importing modules"
	},
	"Enum declaration": {
		"prefix": "enum",
		"body": [
			"@export",
			"enum ${1:Name} {",
			"\t${2:Member},",
			"\t${0}",
			"}"
		],
		"description": "Enum declaration"
	},
	"Enum declaration (empty)": {
		"prefix": "enume",
		"body": [
			"enum ${1:Name} { }"
		],
		"description": "Empty enum declaration"
	},
	"Resource declaration": {
		"prefix": "resource",
		"body": [
			"@export",
			"resource ${1:Name} {",
			"\t${2:field}: ${3:type} = ${4:value},",
			"\t${0}",
			"}"
		],
		"description": "Resource declaration with a typed, defaulted field"
	},
	"Resource declaration (empty)": {
		"prefix": "resourcee",
		"body": [
			"resource ${1:Name} { }"
		],
		"description": "Empty resource declaration"
	},
	"Node declaration": {
		"prefix": "node",
		"body": [
			"node ${1:name} = ${2:NodeType}(${0})"
		],
		"description": "Node declaration"
	},
	"Node declaration with trigger": {
		"prefix": "nodeon",
		"body": [
			"node ${1:name} = ${2:NodeType}(${3:args}) on ${4:trigger}"
		],
		"description": "Node declaration with an on clause"
	},
	"Node declaration with multiple triggers": {
		"prefix": "nodeonm",
		"body": [
			"node ${1:name} = ${2:NodeType}(${3:args}) on ${4:a}, ${5:b}"
		],
		"description": "Node declaration with multiple triggers"
	},
	"Inline node expression": {
		"prefix": "nodeexpr",
		"body": [
			"${1:NodeType}(${0})"
		],
		"description": "Inline node expression"
	},
	"Qualified node type": {
		"prefix": "nodeq",
		"body": [
			"node ${1:name} = ${2:module}::${3:NodeType}(${0})"
		],
		"description": "Node declaration using a module-qualified node type"
	},
	"Qualified resource field type": {
		"prefix": "fieldq",
		"body": [
			"${1:field}: ${2:module}::${3:Type} = ${0},"
		],
		"description": "Resource field with a module-qualified type"
	},
	"Enum member value": {
		"prefix": "enumval",
		"body": [
			"${1:Enum}.${2:Member}"
		],
		"description": "Enum member access as a value"
	},
	"Resource field access": {
		"prefix": "fieldval",
		"body": [
			"${1:Resource}.${2:field}"
		],
		"description": "Resource field access as a value"
	},
	"Boolean literal": {
		"prefix": "true",
		"body": [
			"true"
		],
		"description": "Boolean true"
	},
	"Boolean literal false": {
		"prefix": "false",
		"body": [
			"false"
		],
		"description": "Boolean false"
	},
	"Nil literal": {
		"prefix": "nil",
		"body": [
			"nil"
		],
		"description": "Nil value"
	},
	"Negative float literal": {
		"prefix": "negf",
		"body": [
			"-${1:0.0}"
		],
		"description": "Negative float literal (sign is part of the literal)"
	},
	"Block comment": {
		"prefix": "/-",
		"body": [
			"/-",
			"\t${0}",
			"-/"
		],
		"description": "Nestable block comment"
	},
	"Line comment": {
		"prefix": "--",
		"body": [
			"-- ${0}"
		],
		"description": "Single-line comment"
	}
}